each other -- this is what should spike on OOD inputs)\n","metadata":{}},{"id":"f3ff766f","cell_type":"code","source":"def mc_dropout_forward(model, x):\n    \"\"\"Force dropout to stay active even though the rest of the model is in eval mode.\"\"\"\n    model.eval()\n    for m in model.modules():\n        if isinstance(m, nn.Dropout):\n            m.train()\n    return model(x)\n\n\ndef predict_with_uncertainty(\n    model,\n    loader,\n    n_samples=10,\n    model_type='abnn'\n):\n    \"\"\"\n    Single-model uncertainty evaluation.\n\n    Used for:\n      - deterministic baseline\n      - MC-Dropout\n      - compatibility with the original notebook\n\n    Returns:\n      mean_probs, total_entropy, aleatoric, epistemic, labels\n    \"\"\"\n    all_mean_probs = []\n    all_total = []\n    all_aleatoric = []\n    all_epistemic = []\n    all_labels = []\n\n    if model_type == 'abnn':\n        set_bnl_sampling(model, True)\n\n    n_passes = 1 if model_type == 'deterministic' else n_samples\n\n    with torch.no_grad():\n        for xb, yb in loader:\n            xb = xb.to(device)\n\n            probs_all = []\n\n            for _ in range(n_passes):\n\n                if model_type == 'mcdropout':\n                    logits = mc_dropout_forward(model, xb)\n                else:\n                    model.eval()\n                    logits = model(xb)\n\n                probs_all.append(\n                    F.softmax(logits, dim=1)\n                )\n\n            probs_stack = torch.stack(\n                probs_all,\n                dim=0\n            )\n\n            mean_probs = probs_stack.mean(dim=0)\n\n            total_entropy = -(\n                mean_probs *\n                torch.log(mean_probs + 1e-12)\n            ).sum(dim=1)\n\n            per_sample_entropy = -(\n                probs_stack *\n                torch.log(probs_stack + 1e-12)\n            ).sum(dim=2)\n\n            aleatoric = per_sample_entropy.mean(dim=0)\n\n            epistemic = (\n                total_entropy -\n                aleatoric\n            )\n\n            all_mean_probs.append(\n                mean_probs.cpu().numpy()\n            )\n\n            all_total.append(\n                total_entropy.cpu().numpy()\n            )\n\n            all_aleatoric.append(\n                aleatoric.cpu().numpy()\n            )\n\n            all_epistemic.append(\n                epistemic.cpu().numpy()\n            )\n\n            all_labels.append(\n                yb.numpy()\n            )\n\n    if model_type == 'abnn':\n        set_bnl_sampling(model, False)\n\n    return (\n        np.concatenate(all_mean_probs),\n        np.concatenate(all_total),\n        np.concatenate(all_aleatoric),\n        np.concatenate(all_epistemic),\n        np.concatenate(all_labels)\n    )\n\n\ndef predict_abnn_ensemble(\n    models,\n    loader,\n    n_samples=10\n):\n    \"\"\"\n    ABNN predictive distribution using the paper's M x L approximation.\n\n        P(y | x,D) ≈ 1/(M L)\n            sum_m sum_l P(y | x, omega_m, epsilon_l)\n\n    Here:\n        M = number of independently trained ABNN modes\n        L = stochastic BNL samples per mode\n\n    Returns:\n        mean_probs,\n        total_entropy,\n        aleatoric,\n        epistemic,\n        labels\n    \"\"\"\n    all_mean_probs = []\n    all_total = []\n    all_aleatoric = []\n    all_epistemic = []\n    all_labels = []\n\n    for model in models:\n        model.eval()\n        set_bnl_sampling(model, True)\n\n    with torch.no_grad():\n\n        for xb, yb in loader:\n\n            xb = xb.to(device)\n\n            all_predictions = []\n\n            # M independent ABNN modes\n            for model in models:\n\n                model.eval()\n\n                # L independent BNL noise samples\n                for _ in range(n_samples):\n\n                    logits = model(xb)\n\n                    probs = F.softmax(\n                        logits,\n                        dim=1\n                    )\n\n                    all_predictions.append(probs)\n\n            # Shape:\n            # (M*L, batch, classes)\n            probs_stack = torch.stack(\n                all_predictions,\n                dim=0\n            )\n\n            # Predictive distribution:\n            # average over all M*L predictions\n            mean_probs = probs_stack.mean(dim=0)\n\n            # Total predictive uncertainty\n            total_entropy = -(\n                mean_probs *\n                torch.log(mean_probs + 1e-12)\n            ).sum(dim=1)\n\n            # Expected entropy\n            per_sample_entropy = -(\n                probs_stack *\n                torch.log(probs_stack + 1e-12)\n            ).sum(dim=2)\n\n            aleatoric = per_sample_entropy.mean(dim=0)\n\n            # Mutual-information-style epistemic uncertainty\n            epistemic = (\n                total_entropy -\n                aleatoric\n            )\n\n            all_mean_probs.append(\n                mean_probs.cpu().numpy()\n            )\n\n            all_total.append(\n                total_entropy.cpu().numpy()\n            )\n\n            all_aleatoric.append(\n                aleatoric.cpu().numpy()\n            )\n\n            all_epistemic.append(\n                epistemic.cpu().numpy()\n            )\n\n            all_labels.append(\n                yb.cpu().numpy()\n            )\n\n    for model in models:\n        set_bnl_sampling(model, False)\n\n    return (\n        np.concatenate(all_mean_probs),\n        np.concatenate(all_total),\n        np.concatenate(all_aleatoric),\n        np.concatenate(all_epistemic),\n        np.concatenate(all_labels)\n    )\n\n\ndef expected_calibration_error(probs, labels, n_bins=10):\n    \"\"\"Standard binned ECE: |confidence - accuracy|, weighted by bin size.\"\"\"\n    confidences = probs.max(axis=1)\n    predictions = probs.argmax(axis=1)\n    accuracies = (predictions == labels).astype(float)\n\n    bins = np.linspace(0, 1, n_bins + 1)\n\n    ece = 0.0\n\n    for lo, hi in zip(bins[:-1], bins[1:]):\n\n        mask = (\n            (confidences > lo) &\n            (confidences <= hi)\n        )\n\n        if mask.sum() > 0:\n\n            bin_acc = accuracies[mask].mean()\n            bin_conf = confidences[mask].mean()\n\n            ece += (\n                (mask.sum() / len(labels)) *\n                abs(bin_acc - bin_conf)\n            )\n\n    return ece\n\n\ndef ood_auroc_fpr95(id_scores, ood_scores):\n    \"\"\"\n    AUROC and FPR-at-95%-TPR for separating ID vs OOD\n    using uncertainty as the OOD score.\n    \"\"\"\n    scores = np.concatenate([\n        id_scores,\n        ood_scores\n    ])\n\n    labels = np.concatenate([\n        np.zeros(len(id_scores)),\n        np.ones(len(ood_scores))\n    ])\n\n    auroc = roc_auc_score(\n        labels,\n        scores\n    )\n\n    # 95% of OOD points should be above this threshold.\n    thresh = np.percentile(\n        ood_scores,\n        5\n    )\n\n    fpr95 = (\n        id_scores >= thresh\n    ).mean()\n\n    return auroc, fpr95\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-23T20:48:52.153368Z","iopub.execute_input":"2026-08-23T20:48:52.153773Z","iopub.status.idle":"2026-08-23T20:48:52.173967Z","shell.execute_reply.started":"2026-08-23T20:48:52.153742Z","shell.execute_reply":"2026-08-23T20:48:52.173199Z"}},"outputs":[],"execution_count":16},{"id":"a71b25e8","cell_type":"markdown","source":"## 5. Run the full evaluation for all three models","metadata":{}},{"id":"cee6c718","cell_type":"code","source":"results = {}\n\nprint(\n    f\"ABNN evaluation: \"\n    f\"M={N_ABNN_MODELS} modes x \"\n    f\"L={N_MC_SAMPLES} stochastic samples = \"\n    f\"{N_ABNN_MODELS * N_MC_SAMPLES} forward passes per input\"\n)\n\n\n# ============================================================\n# 1. Deterministic\n# ============================================================\n\nprint(\"\\nEvaluating Deterministic...\")\n\nstart = time.time()\n\nprobs, total_u, aleatoric_u, epistemic_u, labels = (\n    predict_with_uncertainty(\n        baseline_model,\n        test_loader,\n        n_samples=1,\n        model_type='deterministic'\n    )\n)\n\ninference_time = time.time() - start\n\nacc = (\n    probs.argmax(axis=1) == labels\n).mean()\n\nnll = F.nll_loss(\n    torch.log(torch.tensor(probs) + 1e-12),\n    torch.tensor(labels),\n    reduction='mean'\n).item()\n\nece = expected_calibration_error(\n    probs,\n    labels\n)\n\n_, _, _, ood_epistemic, _ = (\n    predict_with_uncertainty(\n        baseline_model,\n        ood_loader,\n        n_samples=1,\n        model_type='deterministic'\n    )\n)\n\nauroc, fpr95 = ood_auroc_fpr95(\n    epistemic_u,\n    ood_epistemic\n)\n\nresults['Deterministic'] = {\n    'Accuracy': acc,\n    'NLL': nll,\n    'ECE': ece,\n    'OOD AUROC': auroc,\n    'OOD FPR95': fpr95,\n    'Forward passes': 1,\n    'Inference time (s)': inference_time,\n    '_epistemic_id': epistemic_u,\n    '_epistemic_ood': ood_epistemic,\n}\n\n\n# ============================================================\n# 2. ABNN — M x L predictive averaging\n# ============================================================\n\nprint(\"\\nEvaluating ABNN...\")\n\nstart = time.time()\n\nprobs, total_u, aleatoric_u, epistemic_u, labels = (\n    predict_abnn_ensemble(\n        abnn_models,\n        test_loader,\n        n_samples=N_MC_SAMPLES\n    )\n)\n\ninference_time = time.time() - start\n\nacc = (\n    probs.argmax(axis=1) == labels\n).mean()\n\nnll = F.nll_loss(\n    torch.log(torch.tensor(probs) + 1e-12),\n    torch.tensor(labels),\n    reduction='mean'\n).item()\n\nece = expected_calibration_error(\n    probs,\n    labels\n)\n\n_, _, _, ood_epistemic, _ = (\n    predict_abnn_ensemble(\n        abnn_models,\n        ood_loader,\n        n_samples=N_MC_SAMPLES\n    )\n)\n\nauroc, fpr95 = ood_auroc_fpr95(\n    epistemic_u,\n    ood_epistemic\n)\n\nresults['ABNN'] = {\n    'Accuracy': acc,\n    'NLL': nll,\n    'ECE': ece,\n    'OOD AUROC': auroc,\n    'OOD FPR95': fpr95,\n    'Forward passes': N_ABNN_MODELS * N_MC_SAMPLES,\n    'Inference time (s)': inference_time,\n    '_epistemic_id': epistemic_u,\n    '_epistemic_ood': ood_epistemic,\n}\n\n\n# ============================================================\n# 3. MC-Dropout\n# ============================================================\n\nprint(\"\\nEvaluating MC-Dropout...\")\n\nstart = time.time()\n\nprobs, total_u, aleatoric_u, epistemic_u, labels = (\n    predict_with_uncertainty(\n        mcd_model,\n        test_loader,\n        n_samples=N_MC_SAMPLES,\n        model_type='mcdropout'\n    )\n)\n\ninference_time = time.time() - start\n\nacc = (\n    probs.argmax(axis=1) == labels\n).mean()\n\nnll = F.nll_loss(\n    torch.log(torch.tensor(probs) + 1e-12),\n    torch.tensor(labels),\n    reduction='mean'\n).item()\n\nece = expected_calibration_error(\n    probs,\n    labels\n)\n\n_, _, _, ood_epistemic, _ = (\n    predict_with_uncertainty(\n        mcd_model,\n        ood_loader,\n        n_samples=N_MC_SAMPLES,\n        model_type='mcdropout'\n    )\n)\n\nauroc, fpr95 = ood_auroc_fpr95(\n    epistemic_u,\n    ood_epistemic\n)\n\nresults['MC-Dropout'] = {\n    'Accuracy': acc,\n    'NLL': nll,\n    'ECE': ece,\n    'OOD AUROC': auroc,\n    'OOD FPR95': fpr95,\n    'Forward passes': N_MC_SAMPLES,\n    'Inference time (s)': inference_time,\n    '_epistemic_id': epistemic_u,\n    '_epistemic_ood': ood_epistemic,\n}\n\n\n# ============================================================\n# Results table\n# ============================================================\n\nimport pandas as pd\n\nsummary_df = pd.DataFrame({\n    k: {\n        mk: mv\n        for mk, mv in v.items()\n        if not mk.startswith('_')\n    }\n    for k, v in results.items()\n}).T\n\nsummary_df\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-08-23T20:48:52.17502Z","iopub.execute_input":"